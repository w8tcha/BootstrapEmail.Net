# Normalize line endings in the repository, use platform default in the working tree
* text=auto

# Templates, styles and test fixtures are read at runtime and compared against
# golden files, so keep them LF on every platform (CI runs on Windows)
*.html text eol=lf
*.erb  text eol=lf
*.scss text eol=lf
*.css  text eol=lf

*.bat  text eol=crlf

*.png  binary
*.exe  binary
*.snapshot binary
